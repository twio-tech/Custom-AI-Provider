<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_provider_view_tree" model="ir.ui.view">
        <field name="name">ai.provider.list</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <list string="AI Providers">
                <field name="name"/>
                <field name="technical_name"/>
                <field name="base_url"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ai_provider_view_form" model="ir.ui.view">
        <field name="name">ai.provider.form</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. OpenAI"/></h1>
                    </div>
                    <div class="alert alert-info" role="alert">
                        <strong>Data sharing with your AI provider</strong>
                        <p>Requests send conversation messages, agent instructions, tool definitions, tool results and relevant attachments to the configured provider. Image and transcription requests may also send images, documents or audio. The provider's processing and retention terms apply, and usage may incur charges.</p>
                        <p>Authorize only if you are permitted to share this data and have reviewed the provider's terms. Connection tests send your API key to the configured endpoint. No connection test or AI request is allowed until you authorize data sharing.</p>
                        <field name="data_sharing_accepted"/>
                        <label for="data_sharing_accepted" string="I authorize data sharing with this provider on behalf of my organization."/>
                    </div>
                    <group>
                        <group name="configuration" string="Configuration">
                            <field name="technical_name"/>
                            <field name="base_url" placeholder="https://api.openai.com/v1"/>
                            <field name="api_key" password="True" placeholder="sk-..."/>
                            <field name="active"/>
                        </group>
                        <group name="status" string="Status">
                            <field name="connection_status"/>
                            <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_provider_action" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">ai.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
