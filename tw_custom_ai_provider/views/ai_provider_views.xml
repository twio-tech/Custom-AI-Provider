<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_provider_view_tree" model="ir.ui.view">
        <field name="name">ai.provider.list</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <list string="AI Providers">
                <field name="name"/>
                <field name="technical_name"/>
                <field name="base_url"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="ai_provider_view_form" model="ir.ui.view">
        <field name="name">ai.provider.form</field>
        <field name="model">ai.provider</field>
        <field name="arch" type="xml">
            <form string="AI Provider">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. OpenAI"/></h1>
                    </div>
                    <group>
                        <group name="configuration" string="Configuration">
                            <field name="technical_name"/>
                            <field name="base_url" placeholder="https://api.openai.com/v1"/>
                            <field name="api_key" password="True" placeholder="sk-..."/>
                            <field name="active"/>
                        </group>
                        <group name="status" string="Status">
                            <field name="connection_status"/>
                            <button name="action_test_connection" type="object" string="Test Connection" class="btn-primary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_provider_action" model="ir.actions.act_window">
        <field name="name">AI Providers</field>
        <field name="res_model">ai.provider</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
