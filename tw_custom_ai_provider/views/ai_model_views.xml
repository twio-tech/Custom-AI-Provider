<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ai_model_view_tree" model="ir.ui.view">
        <field name="name">ai.model.list</field>
        <field name="model">ai.model</field>
        <field name="arch" type="xml">
            <list string="AI Models">
                <field name="name"/>
                <field name="is_openrouter_default" column_invisible="True"/>
                <field name="technical_name" readonly="is_openrouter_default"/>
                <field name="provider_id"/>
                <field name="active" widget="boolean_toggle" readonly="is_openrouter_default"/>
            </list>
        </field>
    </record>

    <record id="ai_model_view_form" model="ir.ui.view">
        <field name="name">ai.model.form</field>
        <field name="model">ai.model</field>
        <field name="arch" type="xml">
            <form string="AI Model">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. GPT-4o mini"/></h1>
                    </div>
                    <group>
                        <group name="definition" string="Definition">
                            <field name="is_openrouter_default" invisible="1"/>
                            <field name="provider_id" widget="many2one" readonly="is_openrouter_default"/>
                            <field name="technical_name" placeholder="e.g. gpt-4o-mini" readonly="is_openrouter_default"/>
                            <field name="active" readonly="is_openrouter_default"/>
                        </group>
                        <group name="readiness" string="Readiness">
                            <field name="is_api_ready" widget="boolean" readonly="1"/>
                        </group>
                    </group>
                    <div class="text-muted" invisible="not is_openrouter_default">Requests omit the model parameter and use the default configured in your OpenRouter account.</div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="ai_model_action" model="ir.actions.act_window">
        <field name="name">AI Models</field>
        <field name="res_model">ai.model</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="ai_model_action_from_provider" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="res_model">ai.model</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('provider_id', '=', active_id)]</field>
        <field name="context">{'default_provider_id': active_id}</field>
    </record>
</odoo>
